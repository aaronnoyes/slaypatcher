# Copy to perf.env (next to sts2) to set experiment knobs without editing the launcher.
# One change per run, and give each run a label so the CSVs are easy to tell apart.

SLAYPERF_LABEL=baseline
# SLAYPERF_PARTICLES=off        # on | half | off
# SLAYPERF_SPINE_HZ=15          # 0 = every frame
# SLAYPERF_SHADERS=passthrough  # on | passthrough (looks wrong on purpose)
# SLAYPERF_PRELOAD_VFX=false
# SLAYPERF_HUD=true                # on-screen overlay (off by default)

# SLAY_MODS=0                   # vanilla, no mods at all (no HUD/CSV either)
# SLAY_GOVERNOR=performance
# SLAY_DOTNET_TWEAKS=1
